{
  "name": "jarvis-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "springs": "node scripts/gen-springs.mjs",
    "springs:check": "node scripts/gen-springs.mjs --check",
    "e2e": "playwright test",
    "e2e:motion": "playwright test e2e/motion-reduced.spec.ts e2e/motion-props.spec.ts e2e/interaction-budget.spec.ts e2e/carcass.spec.ts",
    "e2e:layout": "playwright test e2e/hit-areas.spec.ts e2e/keyboard.spec.ts",
    "e2e:shots": "playwright test e2e/themes-visual.spec.ts",
    "e2e:perf": "playwright test e2e/perf-trace.spec.ts --workers=1",
    "e2e:update": "playwright test e2e/themes-visual.spec.ts --update-snapshots",
    "bundle:check": "vite build --outDir dist-e2e && node scripts/bundle-budget.mjs dist-e2e",
    "ww:verify": "tsc -b && vitest run src/__tests__/ww && npm run springs:check && npm run bundle:check && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "katex": "^0.16.21",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.6",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
